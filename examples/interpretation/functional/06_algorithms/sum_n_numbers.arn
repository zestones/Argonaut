// CATEGORY: example
// IN: 10
// OUT: Enter a number: Sum of first 10 numbers is 55

func sum_n(n : int) -> int {
    return (n * (n + 1)) / 2;
}

proc main() {
    var n : int;

    print("Enter a number: ");
    input("%d", n);

    print("Sum of first %d numbers is %d\n", n, sum_n(n));
}

main();
