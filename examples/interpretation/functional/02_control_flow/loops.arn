// CATEGORY: example
// OUT: For loop example:
// OUT: i = 0
// OUT: i = 1
// OUT: i = 2
// OUT: i = 3
// OUT: i = 4
// OUT:
// OUT: While loop example:
// OUT: j = 0
// OUT: j = 1
// OUT: j = 2
// OUT: j = 3
// OUT: j = 4

var i  : int;
var j  : int;

// For loop
print("For loop example:\n");
for (i := 0; i < 5; i++) {
    print("i = %d\n", i);
}

// While loop
print("\nWhile loop example:\n");
j := 0;
while (j < 5) {
    print("j = %d\n", j);
    j := j + 1;
}
