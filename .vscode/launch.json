{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Compiler (argoc)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/argoc",
            "args": ["-a", "${file}", "-o", "${workspaceFolder}/build/debug/last.ir", "-v"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Build Project"
        },
        {
            "name": "Debug Interpreter (argov)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/argov",
            "args": ["-a", "${workspaceFolder}/build/debug/last.ir"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "Build Project"
        },
        {
            "name": "Debug Unit Tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/unit_tests",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build Project"
        },
        {
            "name": "Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/syntax-highlighting"]
        }
    ]
}
