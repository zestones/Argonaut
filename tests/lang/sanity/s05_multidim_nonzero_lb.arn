// CATEGORY: sanity
// DESC: tableau 2D d'int avec bornes non nulles
// OUT: 11 12 13
// OUT: 21 22 23
type M : array[1:2, 1:3] of int;
var m : M;
var i : int; var j : int;
for (i := 1; i <= 2; i++) { for (j := 1; j <= 3; j++) { m[i, j] := i * 10 + j; } }
for (i := 1; i <= 2; i++) { for (j := 1; j <= 3; j++) { print("%d ", m[i, j]); } print("\n"); }
