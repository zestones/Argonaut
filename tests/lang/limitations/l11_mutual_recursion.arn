func is_odd(n : int) -> int;
func is_even(n : int) -> int { if (n == 0) { return 1; } return is_odd(n - 1); }
func is_odd(n : int) -> int { if (n == 0) { return 0; } return is_even(n - 1); }
print("%d\n", is_even(4));
