# https://editorconfig.org — editors pick this up automatically (VS Code: EditorConfig extension).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h,l,y}]
indent_size = 4

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
